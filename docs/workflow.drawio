        <!-- ===== 用户层 (紫色) ===== -->
        <mxCell id="user1" value="① 用户发送请求&#xa;&quot;使用 agnes 生成一张赛博朋克城市图片&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;fontStyle=1;" vertex="1" parent="1">
